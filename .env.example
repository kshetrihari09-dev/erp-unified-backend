# ══════════════════════════════════════════════════════════════════════════════
# Byapar Backend — Environment variable template
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env (local dev) and fill in real values there.
# .env / .env.local / .env.production / .env.staging are all gitignored —
# NEVER commit a file containing a real secret, even "just for staging".
#
# In staging/production, set these directly in your deployment platform's
# dashboard (Render/Railway/Vercel/etc.) rather than committing any file.

# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ───────────────────────────────────────────────────────────────
# Prefer DATABASE_URL in staging/prod (most platforms provide it directly).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Fallback individual vars (used only if DATABASE_URL is unset — local dev):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=erp_unified_backend
DB_USER=postgres
DB_PASSWORD=REPLACE_ME

# ─── Auth / JWT ─────────────────────────────────────────────────────────────
# Generate each with:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Use a DIFFERENT random value for JWT_SECRET and JWT_REFRESH_SECRET, and a
# DIFFERENT pair per environment (dev/staging/prod must never share one).
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_64_CHAR_HEX_STRING
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated EXACT origins only — no wildcards, no *.vercel.app /
# *.onrender.com. Add every real frontend origin explicitly.
CORS_ORIGIN=https://your-real-frontend-domain.com

# ─── TLS ────────────────────────────────────────────────────────────────────
HTTPS=false
SSL_KEY_PATH=./certs/localhost-key.pem
SSL_CERT_PATH=./certs/localhost.pem

# ─── Security ───────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
SCANNER_RATE_LIMIT_MAX=100
SESSION_TTL_MINUTES=10

# ─── OTP delivery ───────────────────────────────────────────────────────────
# Provider: console (dev only — never use in production/staging) | twilio |
# meta | gupshup (WhatsApp) — smtp | sendgrid | mailgun (email)
WA_PROVIDER=console
EMAIL_PROVIDER=console
EMAIL_FROM_NAME=Byapar
EMAIL_FROM_ADDRESS=noreply@yourcompany.com
APP_NAME=Byapar

# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WA_FROM=whatsapp:+14155238886
# META_WA_TOKEN=
# META_WA_PHONE_ID=
# META_WA_TEMPLATE_NAME=otp_verification
# GUPSHUP_API_KEY=
# GUPSHUP_APP_NAME=
# GUPSHUP_SRC_NAME=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SENDGRID_API_KEY=
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# MAILGUN_REGION=us

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
MORGAN_FORMAT=combined

# ─── Cloud Storage Integration (optional) ────────────────────────────────────
# Encryption key for OAuth tokens at rest (32 bytes, base64). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CLOUD_STORAGE_ENCRYPTION_KEY=

GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:5000/api/cloud-storage/oauth/google_drive/callback

ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_REDIRECT_URI=http://localhost:5000/api/cloud-storage/oauth/onedrive/callback
ONEDRIVE_TENANT=common

DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_REDIRECT_URI=http://localhost:5000/api/cloud-storage/oauth/dropbox/callback
